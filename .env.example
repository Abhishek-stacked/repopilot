# RepoPilot Global Environment Configuration

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=repopilot
DB_PASSWORD=your_secure_postgres_password
DB_NAME=repopilot
DATABASE_URL=postgresql://repopilot:your_secure_postgres_password@localhost:5432/repopilot

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=repopilot_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=repopilot_super_secret_refresh_key_2026

# Token Encryption Key for Stored GitHub Access Tokens (AES-256)
ENCRYPTION_KEY=repopilot_aes256_encryption_key_32bytes

# GitHub OAuth Application (https://github.com/settings/applications/new)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Client & Services
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000

# LLM Providers (OpenAI / Anthropic / Local Ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434
